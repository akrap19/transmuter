# Copy to `.env`. Do not commit real secrets.
PORT=3010
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3010
# Comma-separate local UI origins (localhost vs 127.0.0.1 and default Next port).
FRONTEND_ORIGIN=http://localhost:3003,http://localhost:3000,http://127.0.0.1:3003,http://127.0.0.1:3000

# MySQL read model. This machine uses host MySQL on :3306, not Docker.
DATABASE_URL="mysql://root:Kojemanga1!@localhost:3306/transmuter"

# Redis cache for GET /coins and GET /coins/:mint
REDIS_URL="redis://localhost:6379"

MEDIA_DIR=.data/media

# Public logo + metadata storage. When all five are set, POST /media writes to R2
# and returns https://media.transmuter.net/<id>.<ext>. Omit them to keep local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=transmuter-media
R2_PUBLIC_URL=https://media.transmuter.net
CACHE_TTL_SECONDS=15

# Indexer (Helius webhook + optional WS catch-up). Leave RPC empty to run the API without chain ingest.
# Public devnet. Program IDs match smart contracts/Anchor.toml and transmuter-frontend/lib/solana/program-ids.ts.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
HELIUS_WEBHOOK_SECRET=
FACTORY_PROGRAM_ID=5D3y69mm4wrz7VcGsagfvnrMorvLar7ZnZaLfd3uVcfV
EOL_PROGRAM_ID=DUYcHygp6rTdf3XY49ewhEyzpUg2QEfWECPTu5ucpaXJ
CSOL_MINT=56Hn5H3KpAbCBefSCJXiWCyRxvWF2qGPKATxibFytcPD
CBTC_MINT=FpTP5s3cWYaWMXjsFrtLjZBTPcjvQQHksBFKasVrdAFh
INDEXER_FROM_SLOT=0
