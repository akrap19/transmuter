# Copy to `.env`. Do not commit real secrets.
PORT=3001
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3001
FRONTEND_ORIGIN=http://localhost:3000

# MySQL read model (docker compose defaults)
DATABASE_URL="mysql://root:Kojemanga1!@localhost:3306/transmuter"

# Redis cache for GET /coins and GET /coins/:mint
REDIS_URL="redis://localhost:6379"

MEDIA_DIR=.data/media
CACHE_TTL_SECONDS=15

# Indexer (Helius webhook + optional WS catch-up). Leave empty to run the API without chain ingest.
SOLANA_RPC_URL=
SOLANA_WS_URL=
HELIUS_WEBHOOK_SECRET=
FACTORY_PROGRAM_ID=
EOL_PROGRAM_ID=
CSOL_MINT=
CBTC_MINT=
INDEXER_FROM_SLOT=0
